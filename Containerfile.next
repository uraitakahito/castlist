# 新しい castlist（AI-36 の作り直し。crates/server の castlist-next）の image。rc の release（tag に -rc. の付く物）だけが、これで作る。
# 形は Containerfile と同じ: build の段で静的な binary を作り、動かす段は空の image に binary 1 つだけを置く。
# binary は image の中で /castlist-server の名にする（今の image と同じ path・同じ ENTRYPOINT なので、動かす命令は切り替えで替わらず、
# ci/check-image.sh と ci/image-contents.txt もそのまま使える）。今の DB を移す時は、同じ binary に migrate の引数を付けて起こす
# （docs/src/next.md の「データ」）。
# build の段の Rust の版は rust-toolchain.toml と合わせる（合わないと、build の中で別の版を取りに行く）。
FROM docker.io/library/rust:1.100.0-alpine@sha256:8d0e82abfdf9a38071e07cabc5afba4ddbe077631a80e4e742a760c38beadc33 AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
# 作るのは新しい server だけ（今の server の src/ は、workspace の頭の crate なので build に要るが、image には入らない）。
RUN cargo build --release --locked -p castlist-next && mkdir /data

FROM scratch
COPY --from=build /src/target/release/castlist-next /castlist-server
# DB の置き場。動かす時に volume を付ける。
COPY --from=build /data /data
ENV CASTLIST_DB=/data/castlist.db CASTLIST_LISTEN=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/castlist-server"]
