// この repo（とその上の folder）で、roster で担当を起こしたときの設定。書いていない欄は既定のまま。
{
  // roster push が、push の前に流す確かめ（書き方は roster の docs-site の設定のページの「push の前の確かめ」）。
  // CI（ci.yml の test と docs.yml）の中で手元で速く流せる物。試験・image・e2e・model の検査は CI に任せる。
  // 長さ（2026-11-28 に一時の worktree で測った）: fmt 1 秒・clippy 17 秒（作ったばかりの worktree。target は worktree ごと）・0 秒（2 回目）・SQL と字と run の検査 1 秒・mdbook 1 秒未満。
  "push": {
    "checks": [
      {
        "name": "fmt",
        "run": ["cargo", "fmt", "--all", "--check"],
      },
      {
        "name": "clippy",
        "run": ["cargo", "clippy", "--locked", "--all-targets", "--", "-D", "warnings"],
      },
      {
        "name": "check-sql",
        "run": ["ci/check-sql.sh"],
      },
      {
        "name": "check-wording",
        "run": ["ci/check-wording.sh"],
      },
      {
        "name": "check-run-docs",
        "run": ["ci/check-run-docs.sh"],
      },
      {
        "name": "check-release-version",
        "run": ["ci/test-check-release-version.sh"],
      },
      {
        "name": "docs-build",
        "run": ["mdbook", "build", "docs"],
      },
    ],
  },
  "infra": {
    // アクターの台帳（castlist の container と、DB を置く volume）。起こす・止める・volume を消すのは
    // Product Manager だけ（「AI向けのprofileサーバーの起動と停止は私だけができるものとします。」
    // 「profileサーバーのdataのvolume削除も私だけとします」）。どの担当も打てない（pm-only）。
    // Product Manager が自分の terminal で直に打つ。担当は、打ってほしい 1 行を確認のページに書いて roster ask pm で送る。
    // container の名は castlist.box（0.1.1 から。同じ network の container が DNS の domain box で名で引く）。
    // 前の名 castlist の項目も残す（0.1.0 の docs の名で動かしている間と、前の名で起こし直す試みを止めるため）。
    // volume は castlist-data-v1（1.0.0 から）。
    // roster の guard の当て方（roster の docs-site の設定のページの「環境の手続き」）のうち、要るところだけ:
    // - 項目は命令の語で当て、末尾に * の語は前方一致（castlist-data* は volume の castlist-data-v1 と、-v の値 castlist-data-v1:/data に当たる）。
    //   container の命令の旗はそろえてから当てるので、--name=…・--volume …・--mount …,source=… も、--name …・-v … の項目で当たる。
    //   語で当たらなくても、命令の字に項目の字（--name=… と --volume … の書き方も）が含まれれば止める。
    // - 名を宣言した container（--name の項目）と volume（-v の項目）を的にする container の命令は、ここに書いていない動詞
    //   （exec・cp・commit・export など）でも止まる。読むだけの logs・inspect・stats・ls（volume は inspect・ls）は通る（roster の t-d37r）。
    // 裸の castlist-data は項目にしない（命令の字に含まれれば止まるので、volume の名を grep する読む命令まで止めるため）。
    "castlist": {
      "guard": "pm-only",
      "match": [
        "--name castlist.box",
        "container start castlist.box",
        "container stop castlist.box",
        "container kill castlist.box",
        "container delete castlist.box",
        "container rm castlist.box",
        "--name castlist",
        "container start castlist",
        "container stop castlist",
        "container kill castlist",
        "container delete castlist",
        "container rm castlist",
        "container volume delete castlist-data*",
        "container volume rm castlist-data*",
        // castlist-data-v1 を付けて起こす命令（リストア・起きない時に記録を読む物）に当たり、volume に書く道も止める。
        "-v castlist-data*",
        // volume の略の v（container v rm …）。語が volume と違うので、略の形も並べる（roster の t-9tac）。
        "container v delete castlist-data*",
        "container v rm castlist-data*",
      ],
    },
  },
}
