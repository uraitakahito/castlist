// この repo（とその上の folder）で、roster で担当を起こしたときの設定。書いていない欄は既定のまま。
{
  "infra": {
    // アクターの台帳（castlist の container と、DB を置く volume）。起こす・止める・volume を消すのは
    // Product Manager だけ（「AI向けのprofileサーバーの起動と停止は私だけができるものとします。」
    // 「profileサーバーのdataのvolume削除も私だけとします」）。どの担当も打てない（pm-only）。
    // Product Manager が自分の terminal で直に打つ。担当は、打ってほしい 1 行を確認のページに書いて roster ask pm で送る。
    // container の名は castlist.box（0.1.1 から。同じ network の container が DNS の domain box で名で引く）。
    // 前の名 castlist の match も残す（0.1.0 の docs の名で動かしている間と、前の名で起こし直す試みを止めるため）。
    // guard は命令の字に match の字が含まれるかで見るので、前の名の字は新しい名の命令にも当たる。新しい名は、何に当たるかを読めるように書く。
    // volume: 消す命令の castlist-data は、1.0.0 からの castlist-data-v1 に当たる（guard は字が含まれるかで見る）。
    // -v castlist-data は、castlist-data-v1 を付けて起こす命令（リストア・起きない時に記録を読む物）に当たり、volume に書く道も止める。
    // 字の castlist-data だけは match にしない（volume の名を grep するだけの読む命令まで断るため）。
    // 末尾に * の項目は、命令の語で当てる roster の guard（t-7j37）の物で、* の語は前方一致（castlist-data* は castlist-data-v1 に当たる）。
    // 字の含みで見る前の guard では * の項目は当たらず、* の無い項目が当たる。どちらの guard でも守りに穴が空かないよう、両方を並べて置く。
    "castlist": {
      "guard": "pm-only",
      "match": [
        "--name castlist.box",
        // 名を = で繋ぐ形（--name=…）。語も字も、空白で繋ぐ形の項目とは別なので、並べて置く（roster の pagetray の宣言と同じ形。roster の t-vp6r・台帳 #291）。
        "--name=castlist.box",
        "--name=castlist",
        "container start castlist.box",
        "container stop castlist.box",
        "container kill castlist.box",
        "container delete castlist.box",
        "container rm castlist.box",
        "--name castlist",
        "container start castlist",
        "container stop castlist",
        "container kill castlist",
        "container delete castlist",
        "container rm castlist",
        "container volume delete castlist-data",
        "container volume rm castlist-data",
        "-v castlist-data",
        "container volume delete castlist-data*",
        "container volume rm castlist-data*",
        "-v castlist-data*",
        // volume を付ける旗の、長い形（--volume …）。
        "--volume castlist-data",
        "--volume castlist-data*",
        // volume の略の v（container v rm …）。字も語も volume と違うので、略の形も並べる（roster の t-9tac）。
        "container v delete castlist-data*",
        "container v rm castlist-data*",
      ],
    },
  },
}
